# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage
*.lcov
/test-results/
/playwright-report/
/playwright/.cache/
/.lighthouseci/
*.spec.js.snap
*.test.js.snap

# Next.js
/.next/
/out/

# Production builds
/build
/dist/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*~
*.bak
*.orig

# Security-sensitive files
*.key
*.pem
.env
.env.production
.env.staging
.env.development
.env.test
.env*.local
.env*.secret

# Debug and logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE and Editor configurations
.cursor/
.vscode/
.idea/
*.swp
*.swo

# Package manager lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Cache directories
.cache/
.npm/
.yarn/
.pnpm/
.eslintcache
.stylelintcache
.turbo/

# SCSS/Sass
.sass-cache/

# GraphQL codegen
/src/types/graphql/
/generated/
*.generated.*

# Resume build artifacts (generated by .claude/resume/build.sh)
/.claude/resume/resume-built.html
