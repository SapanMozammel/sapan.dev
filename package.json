{
	"name": "sapan.dev",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port=8000 --turbo",
		"dev:webpack": "next dev --port=8000",
		"dev:monitor": "node scripts/dev-monitor.js",
		"build": "next build",
		"start": "next start",
		"sync": "node .formatter/sync.js",
		"type:check": "tsc --noEmit",
		"check:all": "pnpm run type:check && pnpm run lint && pnpm run format:check",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"format:check": "prettier --config .formatter/.prettierrc.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format": "prettier --config .formatter/.prettierrc.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format:all": "pnpm run format && pnpm run lint:fix"
	},
	"dependencies": {
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@reduxjs/toolkit": "^2.8.2",
		"@tabler/icons-react": "^3.34.1",
		"@tailwindcss/postcss": "^4.1.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.12",
		"next": "15.4.4",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-redux": "^9.2.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.12"
	},
	"devDependencies": {
		"@types/node": "24.1.0",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@typescript-eslint/eslint-plugin": "^8.39.1",
		"@typescript-eslint/parser": "^8.39.1",
		"autoprefixer": "^10.4.21",
		"eslint": "9.32.0",
		"eslint-config-next": "15.4.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sass": "^1.90.0",
		"typescript": "5.8.3"
	}
}
