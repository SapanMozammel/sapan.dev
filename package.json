{
	"name": "sapan.dev",
	"version": "0.3.3",
	"private": true,
	"scripts": {
		"dev": "next dev --port=8000 --turbo",
		"dev:webpack": "next dev --port=8000",
		"build": "next build",
		"build:mangled": "pnpm build && pnpm mangle",
		"mangle": "node scripts/mangle.mjs",
		"start": "next start",
		"sync": "node .formatter/sync.js",
		"type:check": "tsc --noEmit",
		"type:check:tests": "tsc -p tsconfig.test.json --noEmit",
		"check:all": "pnpm run type:check && pnpm run type:check:tests && pnpm run lint && pnpm run format:check",
		"lint": "eslint src",
		"lint:fix": "eslint --fix src",
		"format:check": "prettier --config .formatter/.prettierrc.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format": "prettier --config .formatter/.prettierrc.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"imports:organize": "node .formatter/sync.js --organize-imports",
		"format:all": "pnpm run imports:organize && pnpm run format && pnpm run lint:fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:report": "playwright show-report",
		"test:e2e:codegen": "playwright codegen http://localhost:8001",
		"test:e2e:install": "playwright install chromium firefox webkit",
		"gql:codegen": "graphql-codegen --config codegen.ts",
		"gql:codegen:watch": "graphql-codegen --config codegen.ts --watch",
		"lhci": "lhci autorun",
		"lhci:collect": "lhci collect",
		"lhci:assert": "lhci assert",
		"lhci:upload": "lhci upload",
		"email:dev": "email dev --dir src/emails --port 3001",
		"email:build": "email build --dir src/emails",
		"analyze": "cross-env ANALYZE=true next build",
		"analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
		"analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build"
	},
	"dependencies": {
		"@apollo/client": "^4.1.9",
		"@apollo/client-integration-nextjs": "^0.14.5",
		"@marsidev/react-turnstile": "^1.5.1",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-visually-hidden": "^1.2.4",
		"@react-email/components": "^1.0.12",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.6.1",
		"@reduxjs/toolkit": "^2.11.2",
		"@tabler/icons-react": "^3.41.1",
		"@tailwindcss/postcss": "^4.2.4",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.37.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"graphql": "^16.13.2",
		"maath": "^0.10.8",
		"next": "16.2.4",
		"next-intl": "^4.11.0",
		"next-themes": "1.0.0-beta.0",
		"postcss": "^8.5.13",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-redux": "^9.2.0",
		"resend": "^6.12.2",
		"rxjs": "^7.8.2",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"three": "^0.184.0",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@graphql-codegen/cli": "^7.0.0",
		"@graphql-codegen/client-preset": "^6.0.0",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@lhci/cli": "^0.15.1",
		"@next/bundle-analyzer": "^16.2.4",
		"@playwright/test": "^1.59.1",
		"@react-email/preview-server": "5.2.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "25.6.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/three": "^0.184.0",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.5",
		"autoprefixer": "^10.5.0",
		"cross-env": "^10.1.0",
		"eslint": "9.32.0",
		"eslint-config-next": "16.2.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"react-email": "^5.2.11",
		"sass": "^1.99.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.5"
	}
}
