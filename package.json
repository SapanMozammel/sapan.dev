{
	"name": "sapan.dev",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port=8000 --turbo",
		"dev:webpack": "next dev --port=8000",
		"build": "next build",
		"start": "next start",
		"sync": "node .formatter/sync.js",
		"type:check": "tsc --noEmit",
		"check:all": "pnpm run type:check && pnpm run lint && pnpm run format:check",
		"lint": "eslint src",
		"lint:fix": "eslint --fix src",
		"format:check": "prettier --config .formatter/.prettierrc.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format": "prettier --config .formatter/.prettierrc.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"imports:organize": "node .formatter/sync.js --organize-imports",
		"format:all": "pnpm run imports:organize && pnpm run format && pnpm run lint:fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"email:dev": "email dev --dir src/emails --port 3001",
		"email:build": "email build --dir src/emails",
		"analyze": "cross-env ANALYZE=true next build",
		"analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
		"analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build"
	},
	"dependencies": {
		"@marsidev/react-turnstile": "^1.5.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-visually-hidden": "^1.2.4",
		"@react-email/components": "^1.0.12",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.5.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@tabler/icons-react": "^3.41.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.37.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"maath": "^0.10.8",
		"next": "16.2.3",
		"next-intl": "^4.9.1",
		"next-themes": "1.0.0-beta.0",
		"postcss": "^8.5.9",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"react-redux": "^9.2.0",
		"resend": "^6.12.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"three": "^0.182.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.2.3",
		"@react-email/preview-server": "5.2.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "25.6.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/three": "^0.182.0",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.58.1",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.4",
		"autoprefixer": "^10.4.27",
		"cross-env": "^10.1.0",
		"eslint": "9.32.0",
		"eslint-config-next": "16.2.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"jsdom": "^29.0.2",
		"prettier": "^3.8.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"react-email": "^5.2.10",
		"sass": "^1.99.0",
		"typescript": "6.0.2",
		"vitest": "^4.1.4"
	}
}
