{
	"name": "sapan.dev",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port=8000 --turbo",
		"dev:webpack": "next dev --port=8000",
		"build": "next build",
		"start": "next start",
		"sync": "node .formatter/sync.js",
		"type:check": "tsc --noEmit",
		"check:all": "pnpm run type:check && pnpm run lint && pnpm run format:check",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"format:check": "prettier --config .formatter/.prettierrc.js --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"format": "prettier --config .formatter/.prettierrc.js --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
		"imports:organize": "node .formatter/sync.js --organize-imports",
		"format:all": "pnpm run imports:organize && pnpm run format && pnpm run lint:fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"analyze": "cross-env ANALYZE=true next build",
		"analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
		"analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-visually-hidden": "^1.2.4",
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.5.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@tabler/icons-react": "^3.40.0",
		"@tailwindcss/postcss": "^4.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.38.0",
		"gsap": "^3.14.2",
		"maath": "^0.10.8",
		"next": "15.4.4",
		"next-intl": "^4.8.3",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.8",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-redux": "^9.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.2",
		"three": "^0.183.2"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^15.5.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "24.1.0",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.6",
		"@types/three": "^0.183.1",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.1",
		"autoprefixer": "^10.4.27",
		"cross-env": "^7.0.3",
		"eslint": "9.32.0",
		"eslint-config-next": "15.4.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"jsdom": "^29.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sass": "^1.98.0",
		"typescript": "5.8.3",
		"vitest": "^4.1.1"
	}
}
